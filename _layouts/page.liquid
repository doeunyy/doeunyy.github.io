---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.github %}
        <a class="post-title-link" href="{{ page.github }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
          <i class="fa-brands fa-github"></i>
        </a>
      {% endif %}
      {% if page.demo %}
        <a class="post-title-link post-title-link-circle" href="{{ page.demo }}" target="_blank" rel="noopener noreferrer" aria-label="Demo video">
          <i class="fa-solid fa-circle-play"></i>
        </a>
      {% endif %}
      {% if page.article %}
        <a class="post-title-link post-title-link-circle" href="{{ page.article }}" target="_blank" rel="noopener noreferrer" aria-label="Article">
          <i class="fa-solid fa-newspaper"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
    {% if page.period %}
      <p class="post-period">{{ page.period }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
